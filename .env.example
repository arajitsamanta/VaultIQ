# LLM & Embedding Provider Configuration
# For OpenAI (Default):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0

# For Local Ollama (Uncomment and use instead of OpenAI):
# OPENAI_BASE_URL=http://localhost:11434/v1          # (use http://host.docker.internal:11434/v1 if running app in Docker)
# OPENAI_API_KEY=ollama
# OPENAI_CHAT_MODEL=llama3.2
# OPENAI_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Configuration
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=vaultiq
CHROMA_TIMEOUT_SECONDS=60

# RAG Hyperparameters
RAG_MAX_RESULTS=4
RAG_MIN_SCORE=0.55
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=150

# Server
PORT=8080
